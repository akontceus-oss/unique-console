# Скопируйте в .env и заполните. Значения в чат не присылать.
ZAYAVKI_DB_PASSWORD=
# длинная случайная строка: openssl rand -hex 32
ZAYAVKI_SECRET=
# токен для приёма заявок с сайтов (вебхук Тильды и самописного сайта)
ZAYAVKI_INTAKE_TOKEN=
# токен, по которому консоль забирает заявки и оплаты
ZAYAVKI_EXPORT_TOKEN=
ZAYAVKI_TZ=Europe/Moscow
