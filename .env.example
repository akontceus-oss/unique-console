# Скопируйте в .env и заполните. Пустые источники просто пропускаются.

# --- Общее ---
DATABASE_URL=postgresql+psycopg://partyhub:partyhub@db:5432/partyhub
TIMEZONE=Asia/Yerevan
CURRENCY=AMD
CURRENCY_SYMBOL=֏
PHONE_REGION=AM
BUSINESS_NAME=Детский развлекательный центр
PUBLIC_BASE_URL=https://hub.example.com

# --- Вход в дашборд (обязательно поменяйте) ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Токен для приёма заявок с сайта: POST /api/webhooks/form?token=...
WEBHOOK_TOKEN=

# --- Яндекс Директ ---
DIRECT_TOKEN=
DIRECT_CLIENT_LOGIN=
# dry_run — правки только в журнал; sandbox — в песочницу; live — в боевой кабинет
DIRECT_MODE=dry_run

# --- Яндекс Метрика ---
METRIKA_TOKEN=
METRIKA_COUNTER_ID=
METRIKA_GOAL_ID=
# Все цели сайта, которые считает консоль (WhatsApp, звонок, форма…), через запятую; пусто — основная + DIRECT_GOAL_IDS
METRIKA_GOAL_IDS=

# --- Callibri ---
CALLIBRI_EMAIL=
CALLIBRI_TOKEN=
CALLIBRI_SITE_ID=
# CALLIBRI_BASE_URL=https://api.callibri.ru/

# --- Битрикс24 ---
BITRIX_WEBHOOK_URL=
BITRIX_PARTY_DATE_FIELD=
BITRIX_GUESTS_FIELD=
# Чат с заявками: chat123 или 123. Список чатов: python -m partyhub bitrix-chats (вебхуку нужно право im)
BITRIX_CHAT_ID=

# --- Топвизор ---
TOPVISOR_USER_ID=
TOPVISOR_API_KEY=
# Несколько через запятую: 111,222. Пустой REGION_INDEX — все регионы проекта. Список: python -m partyhub topvisor-projects
TOPVISOR_PROJECT_ID=
TOPVISOR_REGION_INDEX=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Чат, из которого бот читает заявки. Узнать ID: python -m partyhub telegram-chats
TELEGRAM_LEADS_CHAT_ID=

# --- Google-таблица заявок ---
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Заявки

# --- ИИ (необязательно): template | openai | gemini | anthropic | yandexgpt ---
# AI_PROVIDER — для наблюдений в отчёте, DIRECT_AI_PROVIDER — по умолчанию во вкладке «Директ».
# Заполните ключи тех моделей, которые хотите использовать: во вкладке их можно переключать.
AI_PROVIDER=template
DIRECT_AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Любой совместимый с OpenAI сервис (OpenRouter, DeepSeek, Azure, локальная модель):
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=yandexgpt/latest

# --- Расписание (время бизнеса) ---
COLLECT_TIME=06:00
REPORT_TIME=09:00
# Как часто забирать новые заявки и обновлять таблицу, минут (0 — только утренним циклом)
LEADS_SYNC_MINUTES=10

# --- Пароль базы для docker-compose ---
POSTGRES_PASSWORD=partyhub
